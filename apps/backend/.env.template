# Comma-separated origins allowed to call public store endpoints.
STORE_CORS=http://localhost:3000

# Comma-separated origins allowed to load the Medusa admin dashboard.
ADMIN_CORS=http://localhost:9000,http://localhost:7001

# Comma-separated origins allowed for browser auth/session flows.
AUTH_CORS=http://localhost:3000,http://localhost:9000

REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
COOKIE_SECURE=false
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-b2b-headless
# If your Postgres host is a non-SSL Docker service name such as `postgres`,
# append `?sslmode=disable` to the URL.
DB_NAME=medusa-b2b-headless
